{
  "name": "Astra Mobile Android Build",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/android-sdk:2": {
      "installGradle": false,
      "platforms": "android-36",
      "buildTools": "36.0.0",
      "ndk": "27.2.12479018"
    }
  },
  "postCreateCommand": "chmod +x ./gradlew && ./gradlew --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-gradle"
      ]
    }
  }
}
